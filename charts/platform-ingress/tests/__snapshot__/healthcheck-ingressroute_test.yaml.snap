answers host-less OPTIONS health checks locally above the fallback priority:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      labels:
        app: platform-ingress
        chart: platform-ingress-1.0.0
        heritage: Helm
        release: ingress
      name: ingress-healthcheck
    spec:
      routes:
        - kind: Rule
          match: Method(`OPTIONS`)
          priority: 2
          services:
            - kind: TraefikService
              name: ping@internal
