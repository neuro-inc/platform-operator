        heritage: Helm
        release: harbor
      name: harbor-bootstrap
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: harbor-bootstrap
    subjects:
      - kind: ServiceAccount
        name: harbor-bootstrap
        namespace: platform
  4: |
    apiVersion: batch/v1
    kind: Job
    metadata:
      annotations:
        argocd.argoproj.io/hook: PostSync
        argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
        helm.sh/hook: post-install,post-upgrade
        helm.sh/hook-delete-policy: before-hook-creation
      labels:
        app: platform-harbor
        chart: platform-harbor-1.0.0
        heritage: Helm
        release: harbor
      name: harbor-bootstrap
    spec:
      backoffLimit: 3
      template:
        metadata:
          annotations:
            checksum/script: 4c4849012f2f91f4f3b2df0d55c1c093ba122308fe3d29f22291dcbc383a83ff
          labels:
            app: platform-harbor
            chart: platform-harbor-1.0.0
            heritage: Helm
            release: harbor
            service: harbor-bootstrap
        spec:
          automountServiceAccountToken: true
          containers:
            - command:
                - python
                - /app/bootstrap.py
              env:
                - name: PYTHONDONTWRITEBYTECODE
                  value: "1"
                - name: HARBOR_URL
                  value: http://harbor-core
                - name: HARBOR_ADMIN_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      key: HARBOR_ADMIN_PASSWORD
                      name: harbor-secrets
                - name: HARBOR_PROJECT
                  value: neuro
                - name: HARBOR_ROBOT
                  value: platform-registry
                - name: SECRET_NAME
                  value: harbor-platform-registry
                - name: WAIT_SECONDS
                  value: "900"
              image: python:3.13-alpine@sha256:2d9aefe2fef018a7eb2c13064c89c71929800fd2e5dccdbf52ea5da5bb8d929a
              imagePullPolicy: IfNotPresent
              name: bootstrap
              resources:
                limits:
                  memory: 128Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
              volumeMounts:
                - mountPath: /app
                  name: script
                  readOnly: true
          priorityClassName: platform-services
          restartPolicy: Never
          securityContext:
            runAsGroup: 65534
            runAsNonRoot: true
            runAsUser: 65534
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: harbor-bootstrap
          volumes:
            - configMap:
                name: harbor-bootstrap
              name: script
