should match snapshot:
  1: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      labels:
        app: platform-harbor
        chart: platform-harbor-1.0.0
        heritage: Helm
        release: harbor
      name: harbor-internal
    spec:
      ingress:
        - from:
            - podSelector:
                matchLabels:
                  app: harbor
                  release: harbor
      podSelector:
        matchExpressions:
          - key: component
            operator: In
            values:
              - database
              - redis
              - registry
        matchLabels:
          app: harbor
          release: harbor
      policyTypes:
        - Ingress
